{
  "name": "killswitch",
  "private": true,
  "type": "module",
  "scripts": {
    "abi": "tsx scripts/export-abi.ts",
    "chain": "anvil --block-time 1 --silent",
    "deploy": "tsx scripts/deploy.ts",
    "relay": "tsx services/relay/index.ts",
    "dashboard": "vite --config apps/dashboard/vite.config.ts",
    "landing": "vite --config apps/landing/vite.config.ts",
    "landing:build": "vite build --config apps/landing/vite.config.ts",
    "mcp": "tsx packages/mcp/server.ts",
    "mcp:build": "esbuild packages/mcp/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/mcp/server.mjs --log-level=warning \"--banner:js=import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit -p .",
    "traffic": "tsx scripts/traffic.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "test": "cd contracts && forge test",
    "build": "vite build --config apps/dashboard/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.58.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
